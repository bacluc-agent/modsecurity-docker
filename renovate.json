{
  "extends": ["config:recommended"],
  "pinDigests": true,
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/coreruleset/modsecurity-crs"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>[a-z\\-]+)-(?<build>\\d+)$"
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor"],
      "reviewers": ["team:nunki"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["patch"],
      "labels": ["renovate", "dependency", "bump:patch"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "labels": ["renovate", "dependency", "bump:minor"]
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["renovate", "dependency", "bump:major"]
    },
    {
      "matchUpdateTypes": ["digest"],
      "labels": ["renovate", "dependency"]
    }
  ]
}
